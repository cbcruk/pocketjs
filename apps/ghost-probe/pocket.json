{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.ghost-probe",
  "name": "pocketjs-ghost-probe",
  "title": "PocketJS: Ghost Probe",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "input.touch",
        "text.glyphs.baked"
      ]
    }
  },
  "app": {
    "entry": "apps/ghost-probe/main.tsx",
    "output": "ghost-probe-main",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [
          379,
          512
        ],
        "presentation": "native"
      }
    }
  }
}
